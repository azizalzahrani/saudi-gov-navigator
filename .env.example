# Language Configuration
LANGUAGE=ar

# LLM Provider (openai, anthropic)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Optional: Service endpoint configurations
ABSHER_API_ENDPOINT=https://www.absher.sa
MUQEEM_API_ENDPOINT=https://muqeem.sa
QIWA_API_ENDPOINT=https://qiwa.sa
TAWAKKALNA_API_ENDPOINT=https://tawakkalna.sdaia.gov.sa
BALADY_API_ENDPOINT=https://balady.gov.sa
MISA_API_ENDPOINT=https://misa.gov.sa
HRSD_API_ENDPOINT=https://www.hrsd.gov.sa
