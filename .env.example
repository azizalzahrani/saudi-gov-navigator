# Language Configuration
LANGUAGE=ar

# LLM Provider (openai, anthropic)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Optional: Service endpoint configurations
ABSHER_API_ENDPOINT=https://www.absher.sa
MUQEEM_API_ENDPOINT=https://muqeem.sa
QIWA_API_ENDPOINT=https://qiwa.sa
TAWAKKALNA_API_ENDPOINT=https://tawakkalna.sa
BALADY_API_ENDPOINT=https://balady.sa
MISA_API_ENDPOINT=https://misa.sa
HRSD_API_ENDPOINT=https://hrsd.org.sa
